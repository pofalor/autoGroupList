# Скопируйте файл в .env и заполните значения: docker compose подхватит его автоматически.
# .env содержит секреты и в репозиторий не коммитится.

# --- База данных ---
POSTGRES_DB=grouplist
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Телеграм ---
# Токен бота, выданный @BotFather
TELEGRAM_BOT_TOKEN=
# Телеграм id тех, кто разворачивает систему. Они становятся основными старостами и могут
# назначать помощников командой /add_leader. Несколько id перечисляются через запятую
LEADER_TELEGRAM_IDS=
# Телеграм id администраторов: им приходят технические уведомления и доступна команда /time
ADMIN_TELEGRAM_IDS=

# --- ВКонтакте ---
# Необязательная секция: если VK_GROUP_TOKEN пуст, бот работает только в телеграме.
# Ключ доступа сообщества с правом «Сообщения». Берётся в настройках сообщества:
# Управление → Работа с API → Ключи доступа. Там же, во вкладке Long Poll API, нужно
# включить Long Poll (версия 5.199) и типы событий «Входящее сообщение» и «Событие с кнопки».
VK_GROUP_TOKEN=
# Айди сообщества (Управление → Работа с API, число без минуса)
VK_GROUP_ID=
# Айди тех, кто разворачивает систему, во ВКонтакте. Они становятся основными старостами
# наравне с указанными в LEADER_TELEGRAM_IDS. Несколько id перечисляются через запятую
LEADER_VK_IDS=
# Айди администраторов во ВКонтакте: им приходят технические уведомления и доступна команда /time
ADMIN_VK_IDS=

# --- Отметка посещаемости ---
# До какого времени студенты могут отмечаться, время в UTC
DEADLINE_TIME=17:00
# Переносить ли отметки на сайт. Если false, логин с паролем не нужны
MARK_ATTENDANCE_ON_SITE=false
SITE_USERNAME=
SITE_PASSWORD=

# --- Приложение ---
# Порт, на котором веб-часть будет доступна на хосте
APP_PORT=8080
