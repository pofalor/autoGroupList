# Скопируйте файл в .env и заполните значения: docker compose подхватит его автоматически.
# .env содержит секреты и в репозиторий не коммитится.

# --- База данных ---
POSTGRES_DB=grouplist
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Телеграм ---
# Токен бота, выданный @BotFather
TELEGRAM_BOT_TOKEN=
# Телеграм id тех, кто разворачивает систему. Они становятся основными старостами и могут
# назначать помощников командой /add_leader. Несколько id перечисляются через запятую
LEADER_TELEGRAM_IDS=
# Телеграм id администраторов: им приходят технические уведомления и доступна команда /time
ADMIN_TELEGRAM_IDS=

# --- Отметка посещаемости ---
# До какого времени студенты могут отмечаться, время в UTC
DEADLINE_TIME=17:00
# Переносить ли отметки на сайт. Если false, логин с паролем не нужны
MARK_ATTENDANCE_ON_SITE=false
SITE_USERNAME=
SITE_PASSWORD=

# --- Приложение ---
# Порт, на котором веб-часть будет доступна на хосте
APP_PORT=8080
